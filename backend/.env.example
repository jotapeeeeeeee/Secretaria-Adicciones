# ═══════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════
PORT=4000
NODE_ENV=development

# ═══════════════════════════════════════════
# CORS - FRONTEND ORIGIN
# Development: http://127.0.0.1:5500
# Production (GitHub Pages): https://jotapeeeeeeee.github.io
# Production (Custom domain): https://tu-dominio.com
# ═══════════════════════════════════════════
FRONTEND_ORIGIN=http://127.0.0.1:5500

# ═══════════════════════════════════════════
# JWT SECRET
# Generate a secure random key:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use the default in production!
# ═══════════════════════════════════════════
JWT_SECRET=change-this-super-secret-key

# ═══════════════════════════════════════════
# ADMIN CREDENTIALS
# Used for initial admin user creation
# The first user is auto-created in the database
# ═══════════════════════════════════════════
ADMIN_EMAIL=admin@secretaria.local
ADMIN_PASSWORD=change-this-admin-password

# ═══════════════════════════════════════════
# EMAIL CONFIGURATION (Gmail SMTP)
# Steps to configure:
# 1. Enable 2-factor authentication in your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password in SMTP_PASS (no spaces)
# ═══════════════════════════════════════════
CONTACT_DESTINATION_EMAIL=jptoledo1302@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jptoledo1302@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Email sender name and address
MAIL_FROM="Secretaria Adicciones <no-reply@secretaria-adicciones.local>"

# ═══════════════════════════════════════════
# PRODUCTION NOTES (Render/Railway)
# ═══════════════════════════════════════════
# PORT: Will be assigned by the platform (use 10000 for Render)
# NODE_ENV: production
# FRONTEND_ORIGIN: https://jotapeeeeeeee.github.io
# JWT_SECRET: Generate unique key per environment
# ADMIN_PASSWORD: Use a strong password
# SMTP_PASS: Store securely in platform's env vars
# NEVER commit .env file to Git!
